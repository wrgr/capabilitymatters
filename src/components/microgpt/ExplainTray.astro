---
/** Provide keyboard-accessible explanatory popups and a source-linked teaching tray. */
---
<dialog id="help-dialog" aria-labelledby="help-title">
  <form method="dialog"><button class="close-dialog" aria-label="Close explanation">Close</button></form>
  <h2 id="help-title"></h2><p id="help-text"></p><button id="help-more">Explain the code behind this</button>
</dialog>
<dialog id="code-tray" aria-labelledby="tray-title">
  <div class="tray-top"><form method="dialog"><button class="close-dialog" aria-label="Close code tray">Close</button></form><p class="eyebrow">Under the surface · The actual code</p><h2 id="tray-title">Explain this code</h2></div>
  <label for="guide-topic">Choose a stage</label><select id="guide-topic"></select>
  <div id="guide-body"></div><p id="guide-question" class="callout"></p>
  <div class="source-controls"><label for="source-module">Source module</label><select id="source-module">
    <option value="engine.js">engine.js · Transformer and gradients</option><option value="worker.js">worker.js · Background training</option><option value="lab.js">lab.js · Training interface</option><option value="bias.js">bias.js · Data, labels and classifier</option><option value="bias-ui.js">bias-ui.js · Bias experiment interface</option><option value="explanations.js">explanations.js · Teaching text</option><option value="explain.js">explain.js · This source viewer</option>
  </select><button id="show-full-source">Show entire module</button></div>
  <p id="source-status" role="status"></p><pre tabindex="0" aria-label="Actual source code with line numbers"><code id="source-code"></code></pre>
  <p class="fine">The model source is an independent JavaScript adaptation of Karpathy's teaching architecture. <a href="/microgpt/NOTICE.md">Attribution and differences</a>.</p>
</dialog>
<script is:inline type="module" src="/microgpt/explain.js"></script>
