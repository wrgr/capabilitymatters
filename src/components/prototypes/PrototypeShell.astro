---
import Base from "../../layouts/Base.astro";
import AiCritiqueLaunch from "./AiCritiqueLaunch.astro";
import evidenceLibrary from "../../data/problems-to-prototypes/evidence.json";

const {
  idea,
  collection,
  cycle,
  assumption,
  falsifier,
  instrumentation,
  status = "Runnable thin-slice prototype"
} = Astro.props;
const evidence = idea.evidence.map((id) => {
  const source = evidenceLibrary.find((entry) => entry.id === id);
  if (!source) throw new Error(`Unknown evidence anchor: ${id}`);
  return source;
});
const reviewFiles = import.meta.glob('../../data/prototypes/reviews-*.json', { eager: true, import: 'default' });
const review = Object.values(reviewFiles).map((file) => (file as Record<string,any>)[idea.id]).find(Boolean);
---

<Base
  title={`${idea.title} · Prototype · Capability Matters`}
  description={idea.prototype}
  active="problems-to-prototypes"
>
  <section class="prototype-hero container-wide">
    <p class="eyebrow">Problems → Prototypes · {collection}</p>
    <div class="hero-grid">
      <div>
        <a class="back" href={`/problems-to-prototypes/#${idea.id}`}>← Back to this problem brief</a>
        <h1>{idea.title}</h1>
        <p class="lede">{idea.gap}</p>
      </div>
      <aside class="status-card">
        <small>Status</small>
        <strong>{status}</strong>
        <p>This page is a teaching prototype, not a validated product. Its local interaction is intentionally inspectable so the design assumption stays visible.</p>
      </aside>
    </div>
  </section>

  <section class="prototype-workbench container-wide">
    <div class="workbench-app">
      <div class="section-kicker">Try it</div>
      <p class="local-note">This exercise runs locally using simple rules. Your entries stay on this page and clear when you reload. No AI service is called.</p>
      <slot name="app" />
    </div>

    <aside class="research-rail">
      <section>
        <small>Why this design?</small>
        <p>{idea.frame}</p>
      </section>
      <section>
        <small>What are we testing?</small>
        <p>{assumption}</p>
      </section>
      <section>
        <small>What would change our minds?</small>
        <p>{falsifier}</p>
      </section>
      <section>
        <small>What should we instrument?</small>
        <p>{instrumentation}</p>
      </section>
    </aside>
  </section>

  <section class="critique-wrap container-wide">
    {review && <details class="critical-review">
      <summary>Critical review of this working prototype</summary>
      <p><strong>Strongest assumption:</strong> {review.assumption}</p>
      <p><strong>Likely failure:</strong> {review.failureMode}</p>
      <p><strong>Test that could change the design:</strong> {review.falsificationTest}</p>
      <p><strong>Non-AI comparison:</strong> {review.nonAiAlternative}</p>
      <p><strong>Evidence to collect:</strong> {review.measurement}</p>
      <p><strong>Human control and access:</strong> {review.risks}</p>
      <h3>Changes made during review</h3>
      <ul>{review.edits.map((edit) => <li>{edit}</li>)}</ul>
      <p class="local-note">This is a design and implementation review, not an empirical validation of learning outcomes.</p>
    </details>}
    <AiCritiqueLaunch idea={idea} collection={collection} />
  </section>

  <section class="brief container-wide">
    <details>
      <summary>Open the underlying design brief and eight-step path</summary>
      <div class="brief-grid">
        <section>
          <h2>A first prototype</h2>
          <p>{idea.prototype}</p>
          <h3>Representative use case</h3>
          <p>{idea.example}</p>
          <h3>Questions worth carrying forward</h3>
          <ul>{idea.questions.map((q) => <li>{q}</li>)}</ul>
          <h3>Evidence anchors</h3>
          <p>These sources motivate the design; they do not validate this prototype.</p>
          <ul>{evidence.map((source) => <li><a href={source.url} target="_blank" rel="noopener">{source.citation}</a> ({source.year})<p>{source.why}</p></li>)}</ul>
        </section>
        <section>
          <div class="cycle-head">
            <div>
              <small>LENS iteration cycle</small>
              <h2>One possible first pass</h2>
            </div>
            <em>Refine → Understand</em>
          </div>
          <ol class="cycle">
            {cycle.map(([name, text], i) =>
              <li>
                <span>{String(i + 1).padStart(2, "0")}</span>
                <div><b>{name}</b><p>{text}</p></div>
              </li>
            )}
          </ol>
        </section>
      </div>
    </details>
  </section>
</Base>

<style>
  .workbench-app{min-width:0}
  .local-note{font-family:var(--sans);font-size:.8rem;color:var(--muted);margin-bottom:1rem}
  .critical-review{border:1px solid var(--border);border-radius:4px;padding:1rem;margin:1.5rem 0;background:var(--tint)}
  .critical-review summary{cursor:pointer;color:var(--accent);font-family:var(--sans);font-weight:700}
  .critical-review p,.critical-review li{font-size:.86rem}.critical-review p:first-of-type{margin-top:1rem}
  .prototype-hero{padding-top:2.2rem;padding-bottom:1.7rem;border-bottom:1px solid var(--border)}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 18rem;gap:2rem;align-items:end}
  .back{font-family:var(--sans);font-size:.78rem;color:var(--muted);border:0}
  .prototype-hero h1{margin-top:.8rem;max-width:18ch}
  .lede{font-size:1.08rem;line-height:1.65;max-width:52rem;color:var(--muted)}
  .status-card{background:var(--tint);border:1px solid var(--border);border-radius:5px;padding:1rem}
  .status-card small,.research-rail small,.section-kicker,.cycle-head small{
    display:block;font-family:var(--sans);font-size:.68rem;text-transform:uppercase;letter-spacing:.11em;color:var(--accent);font-weight:700
  }
  .status-card strong{display:block;margin:.25rem 0 .5rem;font-family:var(--sans);font-size:.9rem}
  .status-card p{font-size:.78rem;line-height:1.5;color:var(--muted);margin:0}
  .prototype-workbench{display:grid;grid-template-columns:minmax(0,1fr) 20rem;gap:2rem;align-items:start;padding-top:2rem}
  .section-kicker{margin-bottom:.6rem}
  .research-rail{display:flex;flex-direction:column;gap:.65rem;position:sticky;top:5.5rem}
  .research-rail section{border:1px solid var(--border);border-radius:4px;padding:.9rem;background:var(--bg)}
  .research-rail p{font-size:.82rem;line-height:1.5;margin:.35rem 0 0}
  .critique-wrap{padding-top:0;padding-bottom:.5rem}
  .brief{padding-top:1.5rem;padding-bottom:3rem}
  .brief>details{border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:1rem 0}
  .brief>details>summary{cursor:pointer;font-family:var(--sans);font-weight:700;color:var(--accent)}
  .brief-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:2rem;padding-top:1.5rem}
  .brief-grid h2{font-size:1.25rem}.brief-grid h3{font-size:1rem;margin-top:1.35rem}
  .brief-grid p,.brief-grid li{font-size:.9rem;line-height:1.55}
  .cycle-head{display:flex;justify-content:space-between;gap:1rem;align-items:end}
  .cycle-head em{font-family:var(--sans);font-size:.72rem;color:var(--muted)}
  .cycle{list-style:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:.55rem}
  .cycle li{display:grid;grid-template-columns:1.8rem 1fr;gap:.45rem;background:var(--tint);border:1px solid var(--border);padding:.65rem;border-radius:3px}
  .cycle li>span{font-family:var(--mono);font-size:.7rem;color:var(--accent)}
  .cycle b{font-family:var(--sans);font-size:.72rem;text-transform:uppercase;letter-spacing:.04em}
  .cycle p{font-size:.79rem;margin:.15rem 0 0}
  @media(max-width:820px){
    .hero-grid,.prototype-workbench,.brief-grid{grid-template-columns:1fr}
    .research-rail{position:static;display:grid;grid-template-columns:1fr 1fr}
  }
  @media(max-width:560px){
    .research-rail,.cycle{grid-template-columns:1fr}
  }
</style>
