---
const { idea, collection = "" } = Astro.props;
const prompt = `Act as a critical learning-engineering reviewer. Review the prototype brief below as a thin-slice experiment, not as a finished product.

Return:
1. The strongest design assumption.
2. The most important plausible failure mode.
3. The highest-value falsification test for the next cycle.
4. One credible non-AI alternative that could address the same capability gap.
5. The next smallest prototype worth building.
6. What should be measured to distinguish engagement from learning, transfer, and real performance.
7. Human-agency, equity, accessibility, privacy, or governance concerns that should change the design.

Be concrete. Separate evidence-backed claims from hypotheses. Do not reward novelty for its own sake, and do not assume more AI is better.

COLLECTION: ${collection}
TITLE: ${idea.title}

CAPABILITY GAP:
${idea.gap}

FIRST PROTOTYPE:
${idea.prototype}

REPRESENTATIVE USE CASE:
${idea.example}

LEARNING / HUMAN-SYSTEM FRAME:
${idea.frame}

QUESTIONS ALREADY IDENTIFIED:
${idea.questions.map((q, i) => `${i + 1}. ${q}`).join("\n")}

FIRST-CYCLE FRAMING:
Understand: ${idea.cycle.understand}
Model: ${idea.cycle.model}
Instrument: ${idea.cycle.instrument}`;
---

<section class="ai-critique" data-ai-critique data-prompt={prompt}>
  <div class="head">
    <div>
      <small>Optional AI critique</small>
      <h3>Take the brief into your own AI environment</h3>
    </div>
    <span>Nothing is sent until you choose.</span>
  </div>
  <p>Copy a self-contained review prompt, then open the AI workspace you already use. The prompt asks for a falsification test, a non-AI alternative, evidence that distinguishes activity from learning, and human-system risks.</p>
  <div class="actions">
    <button type="button" data-copy>Copy critique prompt</button>
    <a href="https://chatgpt.com/" target="_blank" rel="noopener">Open ChatGPT ↗</a>
    <a href="https://claude.ai/" target="_blank" rel="noopener">Open Claude ↗</a>
    <a href="https://gemini.google.com/" target="_blank" rel="noopener">Open Gemini ↗</a>
  </div>
  <p class="copy-status" data-status aria-live="polite"></p>
  <details>
    <summary>Preview the prompt</summary>
    <pre>{prompt}</pre>
  </details>
</section>

<style>
  .ai-critique{border:1px solid var(--border);background:var(--tint);border-radius:5px;padding:1rem}
  .head{display:flex;justify-content:space-between;gap:1rem;align-items:start;flex-wrap:wrap}
  .head small{display:block;font-family:var(--sans);font-size:.67rem;text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-weight:700}
  .head h3{font-size:1.05rem;margin:.25rem 0 0}
  .head>span{font-family:var(--sans);font-size:.7rem;color:var(--muted)}
  .ai-critique>p{font-size:.82rem;line-height:1.5;margin:.65rem 0}
  .actions{display:flex;gap:.45rem;flex-wrap:wrap}
  .actions button,.actions a{font-family:var(--sans);font-size:.74rem;font-weight:700;border-radius:4px;padding:.55rem .7rem}
  .actions button{border:1px solid var(--accent);background:var(--accent);color:var(--bg);cursor:pointer}
  .actions a{border:1px solid var(--border);background:var(--bg);color:var(--accent);text-decoration:none}
  .copy-status{min-height:1.2em;color:var(--accent)}
  details{border-top:1px solid var(--border);padding-top:.65rem}
  details summary{cursor:pointer;font-family:var(--sans);font-size:.74rem;color:var(--muted)}
  pre{white-space:pre-wrap;max-height:24rem;overflow:auto;background:var(--bg);font-size:.72rem;line-height:1.45;margin-top:.6rem}
</style>

<script is:inline>
(function(){
  document.querySelectorAll('[data-ai-critique]').forEach(function(root){
    if(root.dataset.ready==='1') return;
    root.dataset.ready='1';
    var button=root.querySelector('[data-copy]');
    var status=root.querySelector('[data-status]');
    var prompt=root.getAttribute('data-prompt')||'';
    async function copyText(text){
      if(navigator.clipboard && window.isSecureContext){ await navigator.clipboard.writeText(text); return; }
      var ta=document.createElement('textarea'); ta.value=text; ta.setAttribute('readonly',''); ta.style.position='absolute'; ta.style.left='-9999px';
      document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
    }
    button.addEventListener('click',async function(){
      try{await copyText(prompt);status.textContent='Prompt copied. Open your preferred AI workspace and paste it there.';button.textContent='Copied ✓';}
      catch(e){status.textContent='Copy failed. Open the prompt preview and copy it manually.';}
    });
  });
})();
</script>
