---
// Compact homepage links explain each collection on hover, focus, or a touch toggle.
const base = import.meta.env.BASE_URL;
const sections = [
  { path: "case-studies/", title: "Case Studies", action: "Read the evidence", description: "What worked, what failed, and what the evidence supports." },
  { path: "experiments/", title: "Experiments", action: "Explore a lab or project", description: "Teaching labs, research projects, and creative demonstrations." },
  { path: "problems-to-prototypes/", title: "Prototypes", action: "Work from a capability gap", description: "Design briefs, working tools, and plans to test their impact." },
];
---

<nav class="content-guide" aria-label="Explore Capability Matters">
  <span class="guide-heading">Start here:</span>
  {sections.map((section, index) => (
    <span class="guide-item">
      <a href={base + section.path} aria-describedby={"guide-tip-" + index}>{section.title}</a>
      <button type="button" aria-label={"About " + section.title} aria-expanded="false" aria-controls={"guide-tip-" + index}><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" /><path d="M8 7v4M8 4.5v.5" stroke="currentColor" stroke-width="1.5" /></svg></button>
      <span class="guide-tip" id={"guide-tip-" + index} role="tooltip">
        <strong>{section.action}.</strong> {section.description}
      </span>
    </span>
  ))}
</nav>

<style>
  .content-guide { position: relative; display: flex; align-items: center; flex-wrap: wrap; gap: .25rem 1rem; margin-top: .75rem; max-width: 64rem; font-family: var(--hp-sans); font-size: 1rem; }
  .guide-heading { color: #f5f0e8; font-weight: 600; }
  .guide-item { display: inline-flex; align-items: center; }
  a { color: #2cc4b3; font-weight: 600; padding: .25rem 0; text-decoration: underline; text-underline-offset: .2em; }
  button { display: inline-grid; place-items: center; border: 0; background: transparent; color: #c3cbe2; font: inherit; min-width: 1.75rem; min-height: 1.75rem; padding: .2rem; cursor: pointer; }
  a:focus-visible, button:focus-visible { outline: 2px solid #2cc4b3; outline-offset: 3px; }
  /* Overlay descriptions do not reserve space or shift the page when opened. */
  .guide-tip { visibility: hidden; position: absolute; top: 100%; left: 0; z-index: 20; width: min(30rem, 100%); padding: .75rem 1rem; border: 1px solid #40536d; border-radius: 4px; background: #132240; color: #f5f0e8; font-weight: 400; line-height: 1.5; box-shadow: 0 4px 16px #0005; }
  .guide-item:not(.dismissed):hover .guide-tip,
  .guide-item:not(.dismissed):focus-within .guide-tip,
  .guide-item.open .guide-tip { visibility: visible; }
  @media (max-width: 760px) { .content-guide { gap: .25rem .75rem; } }
</style>

<script>
  // Links always navigate; separate info buttons let touch users read descriptions.
  const guide = document.querySelector('.content-guide');
  const items = guide?.querySelectorAll<HTMLElement>('.guide-item');
  items?.forEach((item) => {
    const button = item.querySelector('button');
    button?.addEventListener('click', () => {
      const open = !item.classList.contains('open');
      items.forEach((other) => {
        other.classList.remove('open');
        other.classList.add('dismissed');
        other.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });
      item.classList.toggle('open', open);
      item.classList.toggle('dismissed', !open);
      button.setAttribute('aria-expanded', String(open));
    });
    item.addEventListener('pointerleave', () => item.classList.remove('dismissed'));
    item.addEventListener('pointerenter', () => item.classList.remove('dismissed'));
    item.querySelector('a')?.addEventListener('focus', () => item.classList.remove('dismissed'));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    items?.forEach((item) => {
      item.classList.remove('open');
      item.classList.add('dismissed');
      item.querySelector('button')?.setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('pointerdown', (event) => {
    if (!(event.target instanceof Node) || guide?.contains(event.target)) return;
    items?.forEach((item) => {
      item.classList.remove('open');
      item.classList.add('dismissed');
      item.querySelector('button')?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
