---
// AskAI — a sparkle affordance that opens an AI assistant in a new tab,
// prefilled with a carefully engineered, case-specific prompt. The site is
// static, so this deep-links to the assistant's new-chat query parameter rather
// than generating anything in-page; no API key or backend is involved.
//
// The prompt is a distribution channel for the case fields: whatever the
// casebook asserts, a reader meets here without ever opening the book. So the
// dossier carries the book's own caveats — the "In brief" summary, any COI or
// evidence-tier disclosure, the competing causal readings, and the scope limit
// — and instructs the tutor not to resolve what the record leaves open.
//
// `variant="icon"` is the compact card control; `variant="button"` is the
// labelled control for the detail page.
import { primaryCompetency } from "../lib/lens";

interface Props {
  title: string;
  year: string;
  domains: string[];
  outcome: "fail" | "success";
  /** The case's one-line impact (factual consequence). */
  impact: string;
  /** The casebook's ~100-150 word "In brief" abstract, where the page has it. */
  summary?: string;
  /** The book's Learning-Engineering reading of the case. */
  leInsight: string;
  /** How LENS teaches the case. */
  lensApproach: string;
  /** lens-anchor, e.g. "D3/PT3" — used to name the competency in the prompt. */
  lensAnchor: string;
  /** Conflict-of-interest disclosure, if any — must travel with the case. */
  coi?: string;
  /** Evidence-tier flag, if any — must travel with the case. */
  evidenceFlag?: string;
  /** Rival causal readings the record supports and no study adjudicates. */
  competingReadings?: string[];
  /** One sentence on what the case does not show. */
  scopeLimit?: string;
  variant?: "icon" | "button";
}

const {
  title, year, domains, outcome, impact, summary, leInsight, lensApproach,
  lensAnchor, coi, evidenceFlag, competingReadings = [], scopeLimit,
  variant = "icon",
} = Astro.props;

const competency = primaryCompetency(lensAnchor) ?? "Human-System Collaboration";
const outcomeWord = outcome === "fail" ? "a failure" : "a success";

// Load-bearing caveats travel with the case: the prompt tells the model to
// ground itself in the supplied specifics, so anything qualifying those
// specifics on the page must appear in the dossier too — never a stripped
// version. Each is appended as its own dossier line only when the case sets it.
const dossierExtras = [
  summary ? `\n• IN BRIEF: ${summary}` : "",
  coi ? `\n• DISCLOSURE (carry this caveat, do not ignore it): ${coi}` : "",
  evidenceFlag
    ? `\n• EVIDENCE TIER: ${evidenceFlag} — source confidence flagged; future validation ongoing. Weigh claims accordingly.`
    : "",
  competingReadings.length
    ? `\n• COMPETING READINGS (rival explanations the record supports and no study adjudicates — do not pick a winner as though the evidence settles it):\n${competingReadings.map((r) => `  – ${r}`).join("\n")}`
    : "",
  scopeLimit ? `\n• SCOPE LIMIT (what this case does not show — do not generalize the lesson past this boundary): ${scopeLimit}` : "",
].join("");

// Engineered prompt. Structure: role + framing, a labelled case dossier so the
// assistant is grounded in specifics rather than its own recollection, then a
// numbered task with an epistemic guardrail (weigh contested causation, flag
// uncertainty, don't overclaim — but don't nitpick wording) and a Socratic
// close that pushes transfer to the reader's own work.
const prompt = [
  `You are a rigorous, Socratic tutor in Learning Engineering for Next-Generation Systems (LENS) — the discipline that treats human capability as an engineered parameter of a complex system, extending learning engineering beyond the classroom. Your stance: systems rarely fail because the technology breaks; they fail or succeed on what people can actually do inside them.`,
  `I'm studying this case from the LENS casebook "Capability Matters". Ground yourself in these specifics rather than your own recollection. If a material fact here is wrong — one that would change the lesson — flag it; but don't nitpick exact wording, and treat a fair paraphrase as fine. Debating the causation, mechanism, and interpretation of this case is squarely in scope and welcome. Where the dossier hedges a claim, keep the hedge: don't restate a qualified finding as a settled one.`,
  `• CASE: ${title} (${year}) — ${outcomeWord}\n• DOMAIN: ${domains.join(", ")}\n• WHAT HAPPENED: ${impact}\n• LENS COMPETENCY IN PLAY: ${competency} (${lensAnchor})\n• THE BOOK'S LEARNING-ENGINEERING READING: ${leInsight}\n• HOW LENS TEACHES IT: ${lensApproach}${dossierExtras}`,
  `Please help me learn from it:\n1. Explain the core capability lesson in plain terms — what someone could or couldn't do inside the system, and why that, more than the technology alone, was decisive.\n2. Name the precise mechanism of the ${outcome === "fail" ? "failure" : "success"} — the specific chain by which what people could or couldn't do produced the outcome. Distinguish the mechanism the evidence actually supports from the folk version of this case that gets repeated.\n3. Where the causation is genuinely contested — competing explanations, confounders, an uncertain counterfactual — set out the rival readings and say what evidence would separate them, rather than flattening to one. Flag what's uncertain in the record and don't overclaim beyond what it supports.\n4. Connect the lesson to the "${competency}" competency, and to how you would design for it or gather decision-grade evidence that it holds.\n5. Close by asking me one sharp question that helps me map this lesson onto a system I actually work on — one that respects the scope limit above rather than over-transferring the lesson.`,
  `Be concrete and specific to this case; prefer its particulars over generic best-practice advice.`,
].join("\n\n");

const href = `https://claude.ai/new?q=${encodeURIComponent(prompt)}`;
const label = "Ask AI about this case";
---

<a
  class:list={["ask-ai", variant]}
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={label}
  title={label}
>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
    <path
      d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"
      fill="currentColor"
    />
    <path d="M18.5 14l.7 1.9 1.9.7-1.9.7-.7 1.9-.7-1.9-1.9-.7 1.9-.7.7-1.9z" fill="currentColor" opacity="0.7" />
  </svg>
  {variant === "button" && <span>Ask AI about this case</span>}
</a>

<style>
  .ask-ai {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-2);
    border: none;
    font-family: var(--sans);
    line-height: 1;
    transition: color 0.15s ease, background 0.15s ease;
  }
  /* Compact icon control used on cards. */
  .ask-ai.icon {
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .ask-ai.icon:hover {
    color: #fff;
    background: var(--accent-2);
    border-color: var(--accent-2);
  }
  /* Labelled control used on the detail page. */
  .ask-ai.button {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--accent-2);
    border-radius: 4px;
  }
  .ask-ai.button:hover { color: #fff; background: var(--accent-2); }
</style>
