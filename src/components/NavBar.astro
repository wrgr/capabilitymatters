---
// Top navigation. Two parallel renderings:
//   - Desktop (>=900px): plain horizontal <nav class="desktop-nav">
//   - Mobile/tablet (<900px): collapsed <details> disclosure with a hamburger
// Each shows the same link list; CSS swaps which one is visible.
// Desktop descriptions appear on hover/focus; the mobile menu shows them inline.
// Escape dismisses an open desktop tooltip.
//
// When Base sets body.dark-shell (pageTheme="dark"), :global() rules at the
// bottom of this file recolor the nav for the dark homepage chrome.

interface Props {
  active?: string;
}

const { active } = Astro.props;

const base = import.meta.env.BASE_URL;

const items: { href: string; label: string; slug: string; description?: string }[] = [
  { href: base,                          label: "Welcome",     slug: "welcome" },
  { href: base + "case-studies/",        label: "Case Studies", slug: "case-studies", description: "Documented examples of what worked, what failed, and what the evidence supports." },
  { href: base + "experiments/",         label: "Experiments", slug: "experiments", description: "Interactive teaching labs, research projects, and creative demonstrations." },
  { href: base + "problems-to-prototypes/", label: "Prototypes", slug: "problems-to-prototypes", description: "Capability gaps, design briefs, working tools, and plans to test their impact." },
  { href: base + "about/",               label: "About",       slug: "about" },
];

const activeLabel = items.find((it) => it.slug === active)?.label ?? "Menu";
---

<header class="site-nav">
  <div class="nav-inner">
    <a href={base} class="brand" aria-label="Home">
      <span class="brand-mark">LENS</span>
      <span class="brand-text">Learning Engineering for Next-Generation Systems</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {items.map((it) => (
          <li class="nav-item">
            <a
              href={it.href}
              aria-describedby={it.description ? "nav-tip-" + it.slug : undefined}
              class:list={[{ active: it.slug === active }]}
              aria-current={it.slug === active ? "page" : undefined}
            >
              {it.label}
            </a>
            {it.description && <span class="nav-tooltip" role="tooltip" id={"nav-tip-" + it.slug}>{it.description}</span>}
          </li>
        ))}
      </ul>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Toggle navigation menu">
        <span class="current">{activeLabel}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="Primary (mobile)">
        <ul>
          {items.map((it) => (
            <li>
              <a
                href={it.href}
                class:list={[{ active: it.slug === active }]}
              aria-current={it.slug === active ? "page" : undefined}
              >
                {it.label}
                {it.description && <span class="mobile-description">{it.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .nav-item { position: relative; }
  .nav-tooltip {
    visibility: hidden; position: absolute; right: 0; top: 100%; z-index: 20;
    width: 19rem; padding: .75rem 1rem; border: 1px solid var(--border);
    border-radius: 4px; background: var(--bg); color: var(--ink-soft);
    font-family: var(--sans); font-size: .875rem; line-height: 1.5;
    box-shadow: 0 6px 18px #0002; text-align: left;
  }
  .nav-item:not(.tooltip-dismissed):hover .nav-tooltip,
  .nav-item:not(.tooltip-dismissed):focus-within .nav-tooltip { visibility: visible; }
  .mobile-description { display: block; margin-top: .25rem; font-size: .875rem; font-weight: 400; line-height: 1.4; color: var(--muted); }
  :global(body.dark-shell) .nav-tooltip { background: #132240; border-color: #40536d; color: #f5f0e8; }
  :global(body.dark-shell) .mobile-description { color: #c3cbe2; }

  .site-nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: .75rem var(--page-pad);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    color: var(--ink);
    border: none;
    font-family: var(--serif);
    flex-shrink: 0;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    min-width: 1.8rem;
    height: 1.8rem;
    padding: 0 .35rem;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--sans);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .02em;
    border-radius: 2px;
  }
  .brand-text { font-size: 1rem; font-weight: 600; white-space: nowrap; }

  /* ── Desktop nav (hidden below 900px) ─────────────────────────────────── */
  .desktop-nav { display: none; }
  .desktop-nav ul {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .1rem;
    justify-content: flex-end;
  }
  .desktop-nav a {
    font-family: var(--sans);
    font-size: .85rem;
    color: var(--ink-soft);
    border: none;
    padding: .35rem .65rem;
    border-radius: 3px;
    white-space: nowrap;
  }
  .desktop-nav a:hover { background: var(--tint); color: var(--accent); }
  .desktop-nav a.active {
    color: var(--accent);
    background: var(--tint-warm);
  }

  /* ── Mobile nav (visible below 900px) ─────────────────────────────────── */
  .mobile-nav {
    width: 100%;
    flex: 0 0 100%;
    display: flex;
    justify-content: flex-start;
    position: relative;
  }
  .mobile-nav summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .65rem;
    font-family: var(--sans);
    font-size: .82rem;
    color: var(--ink-soft);
    background: var(--tint);
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    margin-left: 0;
    user-select: none;
    white-space: nowrap;
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav summary .current {
    font-weight: 500;
    color: var(--accent);
    letter-spacing: .02em;
  }
  .mobile-nav[open] summary {
    background: var(--tint-warm);
    border-color: var(--accent);
    color: var(--accent);
  }
  .mobile-nav nav {
    position: absolute;
    left: 0;
    top: calc(100% + .45rem);
    width: min(19rem, calc(100vw - (var(--page-pad) * 2)));
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(26, 29, 26, 0.12);
    overflow: hidden;
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-direction: column;
  }
  .mobile-nav nav a {
    display: block;
    font-family: var(--sans);
    font-size: .95rem;
    color: var(--ink-soft);
    border: none;
    padding: .6rem .5rem;
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav nav a:hover { background: var(--tint); color: var(--accent); }
  .mobile-nav nav a.active {
    color: var(--accent);
    background: var(--tint-warm);
    font-weight: 600;
  }

  @media (max-width: 620px) {
    .brand-text {
      font-size: .9rem;
      max-width: 13ch;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  @media (max-width: 460px) {
    .brand-text { display: none; }
    .nav-inner { gap: .55rem; }
    .mobile-nav summary { padding: .35rem .5rem; }
    .mobile-nav summary .current { display: none; }
    .mobile-nav nav { width: min(16rem, calc(100vw - (var(--page-pad) * 2))); }
  }

  /* ── Swap at 900px ────────────────────────────────────────────────────── */
  @media (min-width: 900px) {
    .nav-inner { flex-wrap: nowrap; }
    .desktop-nav { display: block; }
    .mobile-nav  { display: none; }
  }

  /* ── Dark shell overrides ─────────────────────────────────────────────────
     Activated when Base applies body.dark-shell (homepage). Hardcoded colors
     mirror the homepage palette in src/pages/index.astro.
     Only `body.dark-shell` is wrapped in :global() — the rest of each
     selector stays scoped, so Astro applies the same [data-astro-cid] scoping
     attribute it gives the light-theme rules above. That keeps specificity
     comparable (plus the extra .dark-shell class, so these correctly win);
     a fully-:global()-wrapped selector loses that scoping attribute and can
     lose the specificity fight against `.desktop-nav a.active` above, which
     silently reverted every dark-shell nav color back to the light theme's
     near-black text on the dark navy bar. */
  :global(body.dark-shell) .site-nav {
    background: rgba(10, 22, 40, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(26, 138, 125, 0.15);
  }
  :global(body.dark-shell) .brand { color: #f5f0e8; }
  :global(body.dark-shell) .brand-text { color: #f5f0e8; }
  :global(body.dark-shell) .brand-mark {
    background: #1a8a7d;
    color: #0a1628;
  }
  :global(body.dark-shell) .desktop-nav a { color: #c3cbe2; }
  :global(body.dark-shell) .desktop-nav a:hover {
    background: rgba(44, 196, 179, 0.08);
    color: #2cc4b3;
  }
  :global(body.dark-shell) .desktop-nav a.active {
    color: #2cc4b3;
    background: rgba(44, 196, 179, 0.10);
  }
  :global(body.dark-shell) .mobile-nav summary {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(138, 154, 181, 0.2);
    color: #c3cbe2;
  }
  :global(body.dark-shell) .mobile-nav summary .current { color: #2cc4b3; }
  :global(body.dark-shell) .mobile-nav[open] summary {
    background: rgba(44, 196, 179, 0.08);
    border-color: #2cc4b3;
    color: #2cc4b3;
  }
  :global(body.dark-shell) .mobile-nav nav {
    background: #132240;
    border-color: rgba(138, 154, 181, 0.2);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }
  :global(body.dark-shell) .mobile-nav nav a {
    color: #c3cbe2;
    border-bottom-color: rgba(138, 154, 181, 0.1);
  }
  :global(body.dark-shell) .mobile-nav nav a:hover {
    background: rgba(44, 196, 179, 0.08);
    color: #2cc4b3;
  }
  :global(body.dark-shell) .mobile-nav nav a.active {
    background: rgba(44, 196, 179, 0.10);
    color: #2cc4b3;
  }
</style>

<script>
  // Keep descriptions dismissible without changing normal menu-link navigation.
  const items = document.querySelectorAll<HTMLElement>('.nav-item');
  items.forEach((item) => {
    item.addEventListener('pointerenter', () => item.classList.remove('tooltip-dismissed'));
    item.addEventListener('pointerleave', () => item.classList.remove('tooltip-dismissed'));
    item.addEventListener('focusin', () => item.classList.remove('tooltip-dismissed'));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') items.forEach((item) => item.classList.add('tooltip-dismissed'));
  });
</script>
