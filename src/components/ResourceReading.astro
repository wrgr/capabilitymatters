---
/** Put resource guidance directly under the paper title without changing its manuscript. */
import ResourceAbout from './ResourceAbout.astro';
interface Props {resource: string; html: string;}
const {resource, html} = Astro.props;
const titleEnd = html.indexOf('</h1>');
const boundary = titleEnd < 0 ? -1 : titleEnd + 5;
if (boundary < 0) throw new Error(`Paper introduction boundary missing: ${resource}`);
---
<Fragment set:html={html.slice(0, boundary)} />
<ResourceAbout resource={resource} />
<Fragment set:html={html.slice(boundary)} />
