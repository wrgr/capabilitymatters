---
import PrototypeShell from "../../components/prototypes/PrototypeShell.astro";
import FoundationForm from "../../components/prototypes/aile-foundation-form.astro";
import briefs from "../../data/problems-to-prototypes/aile-2.json";
import meta from "../../data/problems-to-prototypes/meta.json";
const idea = briefs.find((brief) => brief.id === "example-aile-4481")!;
const common = meta.aileCommonSteps;
const cycle = [["Understand", idea.cycle.understand], ["Model", idea.cycle.model], ["Design", common["3"]], ["Build", common["4"]], ["Instrument", idea.cycle.instrument], ["Deploy", common["6"]], ["Evaluate", common["7"]], ["Refine", common["8"]]];
const states = [["unobserved", "Unobserved — no judgment yet"], ["developing", "Observed — needs support"], ["demonstrated", "Observed — demonstrated independently"]];
const fields = [
  { name: "prerequisite", label: "Prerequisite: represents equivalent fractions using the same whole", options: states },
  { name: "explanation", label: "Explanation: justifies common units when adding unlike denominators", options: states },
  { name: "transfer", label: "Transfer: independently solves and justifies a new-context problem", options: states },
  { name: "evidence", label: "Observed work and support given (required for any observed judgment; omit names)", optional: true, rows: 4, placeholder: "Drew 2/3 = 4/6 independently; needed fraction strips to explain addition." },
  { name: "override", label: "Teacher decision", options: [["recommended", "Keep transparent rule recommendation"], ["diagnostic", "Override: gather diagnostic evidence"], ["prerequisite", "Override: equivalent-fraction practice"], ["guided", "Override: guided explanation"], ["transfer", "Override: new-context task"], ["extend", "Override: extension and delayed check"]] },
  { name: "reason", label: "Reason for override (required when overriding)", optional: true, placeholder: "Learner demonstrated this orally; written response is not an accessible measure today." }
];
---
<PrototypeShell idea={idea} collection="AILE" cycle={cycle} assumption="Transparent evidence-based routes help teachers adapt support while keeping the mastery standard stable." falsifier="Routes track missing data or task speed rather than conceptual learning, or reduce access to transfer work." instrumentation="Review independent explanation, new-context performance, delayed retention, teacher override reasons, and opportunity to attempt transfer. No telemetry is collected.">
  <div slot="app">
    <section class="prototype-tool"><div class="panel"><h2>One target: adding fractions with unlike denominators</h2><p>Use a drawing of 2/3 = 4/6, an explanation of 1/2 + 1/3, and a new-context task to inform judgments. Start unobserved when evidence is missing. Do not enter learner names.</p></div></section>
    <FoundationForm tool="mastery-pathway-planner" fields={fields} action="Plan next evidence and practice" description="A fixed fraction-learning pathway using teacher-entered judgments. The rules show their reasoning, keep missing evidence separate from observed difficulty, and allow a reasoned teacher override. This tool does not diagnose learners or certify mastery." />
  </div>
</PrototypeShell>
