---
import PrototypeShell from '../../components/prototypes/PrototypeShell.astro';
import '../../styles/prototype-tools.css';
import briefs from '../../data/problems-to-prototypes/aile-2.json';
import meta from '../../data/problems-to-prototypes/meta.json';
const idea = briefs.find(item => item.id === 'example-aile-4953');
const common = meta.aileCommonSteps;
const cycle = [['Understand', idea.cycle.understand], ['Model', idea.cycle.model], ['Design', common['3']], ['Build', common['4']], ['Instrument', idea.cycle.instrument], ['Deploy', common['6']], ['Evaluate', common['7']], ['Refine', common['8']]];
---
<PrototypeShell idea={idea} collection="AILE" cycle={cycle}
  assumption="Contrasting consequences after an independent decision improve context-sensitive teacher judgment."
  falsifier="Teachers repeat preferred labels but cannot justify a decision on an unseen classroom scenario."
  instrumentation="Compare unseen scenario decisions and observed classroom safeguards with a paper-case discussion; confidence alone is insufficient.">
  <div slot="app" class="prototype-tool" id="aile-teacher"><noscript>Enable JavaScript for local scenario practice.</noscript></div>
</PrototypeShell>
<script>
  import { mountTeacher } from '../../components/prototypes/aile-practice-client.mjs';
  mountTeacher(document.getElementById('aile-teacher'));
</script>
