---
import PrototypeShell from '../../components/prototypes/PrototypeShell.astro';
import '../../styles/prototype-tools.css';
import '../../styles/aile-practice.css';
import briefs from '../../data/problems-to-prototypes/aile-2.json';
import meta from '../../data/problems-to-prototypes/meta.json';
const idea = briefs.find(item => item.id === 'example-aile-8387');
const common = meta.aileCommonSteps;
const cycle = [['Understand', idea.cycle.understand], ['Model', idea.cycle.model], ['Design', common['3']], ['Build', common['4']], ['Instrument', idea.cycle.instrument], ['Deploy', common['6']], ['Evaluate', common['7']], ['Refine', common['8']]];
---
<PrototypeShell idea={idea} collection="AILE" cycle={cycle} status="Runnable 2D precursor · no XR or AI"
  assumption="Predicting state changes and recovering from a signal fault supports independent sequence reasoning."
  falsifier="Learners finish by trial and error but cannot explain or transfer the sequence beyond this toy station."
  instrumentation="Compare blocked attempts, prediction explanations, hint use and independent transfer with a paper troubleshooting exercise; separately validate any real equipment workflow.">
  <div slot="app" class="prototype-tool" id="aile-workflow"><noscript>Enable JavaScript to run the local 2D simulation.</noscript></div>
</PrototypeShell>
<script>
  import { mountWorkflow } from '../../components/prototypes/aile-practice-client.mjs';
  mountWorkflow(document.getElementById('aile-workflow'));
</script>
