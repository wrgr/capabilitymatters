---
/** Present the dynamic-conversation study with its current manuscript and downloads. */
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import Base from "../../layouts/Base.astro";
import AgenticNav from "../../components/AgenticNav.astro";
import { compiledContent, getHeadings } from "../../papers/flower-team-study.md";

import ResourceReading from "../../components/ResourceReading.astro";

let tableNumber = 0;
// Preserve the manuscript while making its wide tables reachable by keyboard.
const paperHtml = (await compiledContent()).replace(/<table\b[^>]*>[\s\S]*?<\/table>/g,
  (table) => `<div class="paper-table" role="region" aria-label="Paper table ${++tableNumber}" tabindex="0">${table}</div>`);
const pdfVersion = createHash("sha256").update(readFileSync("public/agentic-le/paper/flower-team-study.pdf")).digest("hex").slice(0, 12);
const sections = getHeadings().filter((heading) => heading.depth === 2);
---

<Base title="Exploring the learning engineering flower with agentic simulation · Capability Matters"
  description="A modest agentic simulation of the learning engineering flower: dynamic design conversations, scenario tests, separate process and result reviews, and a planned user-change demonstration.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
 <AgenticNav active="paper" />
  <div class="paper-shell">
    <p class="study-link"><strong>Dynamic-conversation pilot.</strong> This paper reports the new two-phase study: bounded design conversations, easy/medium/hard deployment tests, separate expert reviews of process and result, and a planned user-change demonstration. <a href="/agentic-le/dynamic/">Inspect the saved conversations, artifacts and evidence</a>. Earlier exploratory results are preserved in a separate offline appendix.</p>
    <nav class="paper-actions" aria-label="Paper downloads">
      <a class="download" href={`/agentic-le/paper/flower-team-study.pdf?v=${pdfVersion}`} download aria-label="Download PDF: Exploring the learning engineering flower with agentic simulation">Download study PDF</a>
      <a href={`/agentic-le/paper/flower-team-study.md?v=${pdfVersion}`} download aria-label="Download manuscript: Exploring the learning engineering flower with agentic simulation">Download study manuscript</a>
      <a href={`/agentic-le/paper/flower-team-study.docx?v=${pdfVersion}`} download aria-label="Download Word document: Exploring the learning engineering flower with agentic simulation">Download study Word document</a>
    </nav>
    <div class="reading-layout">
      <aside>
        <details open>
          <summary>In this paper</summary>
          <nav aria-label="Paper sections">
            {sections.map((section) => <a href={`#${section.slug}`}>{section.text}</a>)}
          </nav>
        </details>
      </aside>
      <article class="paper"><ResourceReading resource="agentic-paper" html={paperHtml} /></article>
    </div>
  </div>
</Base>

<style>
  .study-link { padding: 1rem 1.2rem; margin: 0 0 1.5rem; background: var(--tint-warm); border-left: 4px solid var(--accent); border-radius: 5px; font-size: .95rem; max-width: none; }
  .paper-shell { max-width: 76rem; margin: auto; padding: 2rem var(--page-pad); }
  .paper-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; padding-bottom: 2rem; font-family: var(--sans); font-size: .9rem; }
  .download { padding: .65rem 1rem; background: var(--accent-2); color: white; border-radius: 4px; }
  .reading-layout { display: grid; grid-template-columns: 14rem minmax(0, 44rem); gap: 3rem; }
  aside { font-family: var(--sans); font-size: .9rem; }
  details { position: sticky; top: 5rem; }
  summary { cursor: pointer; font-weight: 650; margin-bottom: 1rem; }
  aside nav { display: grid; gap: .75rem; }
  aside a { color: var(--ink-soft); line-height: 1.4; }
  .paper { min-width: 0; font-size: 1.1rem; }
  .paper :global(p) { max-width: none; }
  .paper :global(h1) { font-size: clamp(2rem, 5vw, 3.2rem); margin-bottom: .3em; }
  .paper :global(h2) { margin-top: 2.5rem; scroll-margin-top: 7rem; }
  .paper :global(h1 + h2) { margin-top: 0; font-size: 1.5rem; font-weight: 400; color: var(--ink-soft); line-height: 1.4; }
  .paper :global(h3) { margin-top: 1.8rem; }
  .paper :global(.paper-table) { max-width: 100%; overflow-x: auto; margin: 1.5rem 0; }
  .paper :global(.paper-table:focus-visible) { outline: 3px solid var(--accent-2); outline-offset: 3px; }
  .paper :global(table) { display: table; max-width: none; overflow: visible; margin: 0; font-size: .92rem; }
  .paper :global(th), .paper :global(td) { min-width: 9rem; padding: .7rem; }
  .paper :global(ol) { padding-left: 1.4rem; font-size: .95rem; }
  .paper :global(ol li) { margin-bottom: .8rem; }
  .paper :global(a) { text-decoration: underline; text-underline-offset: .16em; }
  @media (max-width: 900px) {
    .reading-layout { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    aside { border: 1px solid var(--border); border-radius: 4px; padding: 1rem; }
    aside nav { grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
    details { position: static; }
  }
  @media print {
    aside, .paper-actions { display: none; }
    .reading-layout { display: block; }
    .paper-shell { padding: 0; }
  }
</style>
