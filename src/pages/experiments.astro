---
// Experiments directory: learning labs, research projects, and creative demonstrations.
// Papers and design briefs are linked separately from runnable projects.

import Base from "../layouts/Base.astro";
import SectionHero from "../components/SectionHero.astro";

interface Experiment {
  title: string;
  group: "labs" | "research" | "creative";
  format: string;
  url: string;
  // One- to two-sentence description of what the experiment is and offers.
  description: string;
  // Short label for the domain, shown under the title (e.g. "calibratedjudgment.org").
  host: string;
  // Optional companion resource for trying the creative process yourself.
  jobAid?: { url: string; label: string };
}

// Supporting reading is distinct from the runnable project directory.
const featuredPaper = {
  title: "Show Your Work",
  url: "/show-your-work/",
  description:
    "The revised grounding paper beneath LENS: what functional work can tell us about output quality, capability, learning, and impact, including when AI contributes to the result. Working draft, September 30, 2026.",
};

// Ordered as presented. Descriptions say what the thing actually does, in its
// own terms — check the live site before editing one, since several of these
// are prototypes whose scope has moved. Two sentences, to match card copy
// elsewhere on the site.
const experiments: Experiment[] = [
  {title: "Project Lifecycle Lab", group: "labs", format: "Agentic lifecycle", url: "/lifecycle-lab/", host: "capabilitymatters.org/lifecycle-lab", description: "Follow a seed through live specialist discussion, scenario challenges and versioned artifacts to a runnable candidate product. Inspect the source, replay its revisions and explore inherited simulation roles and requested proficiency."},
  {
    title: "The Capability Pipeline",
    group: "labs",
    format: "Teaching simulation",
    url: "https://capabilitymatters.org/capability-pipeline/index.html#simulation",
    host: "capabilitymatters.org/capability-pipeline",
    description:
      "Explore the eight-step systems process through five worked examples and a branching teaching simulation. Make decisions, inspect consequences, revise your strategy, and compare branches; the fictional scenarios use explicit teaching assumptions.",
  },
  {
    title: "Rainbow Bug Dash",
    group: "creative",
    format: "Browser game",
    url: "/rainbow-bug/",
    host: "capabilitymatters.org/rainbow-bug",
    description:
      "Collect rainbows, dodge bugs, and explore a browser game co-created by Julian, age 6, with artificial intelligence (AI) as a creative partner. Pair the game with the Vibe Coding job aid by James Diamond and Will Gray-Roncal to try the same process: describe an idea, play with the result, and use your judgment to guide the next revision.",
    jobAid: {
      url: "/vibe-coding-job-aid.docx",
      label: "Vibe Coding job aid (Word)",
    },
  },
  {
    title: "MicroGPT for AI leaders",
    group: "labs",
    format: "Interactive lab",
    url: "https://capabilitymatters.org/microgpt/",
    host: "capabilitymatters.org/microgpt",
    description:
      "A guided companion to Andrej Karpathy's microgpt, connecting model mechanics to perspectives from Andrew Ng and Dario Amodei. Train a tiny transformer in your browser, compare checkpoints, and expose how biased engagement labels can produce misleading scores. Explanations connect each result to the running code.",
  },
  {
    title: "LLM101",
    group: "labs",
    format: "Guided explainer",
    url: "https://capabilitymatters.org/llm101/",
    host: "capabilitymatters.org/llm101",
    description:
      "Next-token prediction explained at five depths, so a reader can take the level they can actually use rather than the one the author found interesting. The build is written up beside it as a worked example of designing for a capability instead of for coverage.",
  },
  {
    title: "Calibrated Judgment",
    group: "research",
    format: "Assessment prototype",
    url: "https://calibratedjudgment.org/",
    host: "calibratedjudgment.org",
    description:
      "Grades an argumentative essay twice — once from the finished text, once from the transcript of the AI dialogue behind it — and reports the gap between them. Every score is anchored to a verbatim quote, and criteria a model should not settle alone route to the instructor, whose override becomes calibration data.",
  },
  {
    title: "ExpertTrace",
    group: "research",
    format: "Mentoring prototype",
    url: "https://experttrace.org",
    host: "experttrace.org",
    description:
      "An AI mentor working from an operational knowledge corpus — symptom to fault to corrective action, plus the tacit cues experts never write down — that probes a learner through a live scenario at a chosen level of expertise. It assesses on unfamiliar scenarios, because repeating a known pattern is not transfer.",
  },
  {
    title: "NeuroTrailblazers",
    group: "research",
    format: "Training and mentorship",
    url: "https://neurotrailblazers.org",
    host: "neurotrailblazers.org",
    description:
      "Training and mentorship for nanoscale connectomics: ten technical units from electron-microscopy basics through NeuroAI analysis, a curated journal club, and hands-on work against real datasets including MICrONS and FlyWire. Built for three audiences at once — students, the mentors supporting them, and programs adopting the model.",
  },
  {
    title: "POP",
    group: "creative",
    format: "Physics sandbox",
    url: "https://wrgr.github.io/pop",
    host: "wrgr.github.io/pop",
    description:
      "A soap-bubble physics sandbox: shape a wand, watch the film billow and deform in moving air, then run the whole thing backwards — fit an ellipse to a photo of a real bubble and read the wind speed back out of the shape it left.",
  },

];
const groups = [
  { id: "labs", title: "Learning labs", description: "Explore a concept through a guided explanation or an interactive teaching model." },
  { id: "research", title: "Research and practice projects", description: "Explore approaches to assessment, mentoring, and workforce development on their own sites. Inclusion here is not evidence of effectiveness." },
  { id: "creative", title: "Creative demonstrations", description: "Games and sandboxes that show what can be built, explored, and revised." },
];
---

<Base title="Experiments · LENS" active="experiments">
  <SectionHero
    eyebrow="Experiments"
    title="Experiments: labs and projects to explore"
    claim="Interactive teaching labs, research projects, and creative demonstrations. Each card identifies what you can open and explore."
    count={experiments.length}
  />

  <div class="container directory-intro">
    <p>For a capability gap, design brief, and evaluation plan, visit <a href="/problems-to-prototypes/">Prototypes</a>.
      For documented examples and their sources, read the <a href="/case-studies/">Case Studies</a>.</p>
    <nav aria-label="Experiment categories">{groups.map((group) => <a href={"#" + group.id}>{group.title}</a>)}</nav>
  </div>

  <div class="section-grid container">
    {groups.map((group) => (
    <section id={group.id} aria-labelledby={group.id + "-title"}>
      <h2 id={group.id + "-title"}>{group.title}</h2>
      <p>{group.description}</p>
    <div class="grid">
      {experiments.filter((exp) => exp.group === group.id).map((exp) => (
        <article class="card">
          <div class="card-meta">
            <span class="format-chip">{exp.format}</span>
          </div>
          <h3 class="card-title">
            <a href={exp.url} target={exp.url.startsWith("https://capabilitymatters.org") || exp.url.startsWith("/") ? undefined : "_blank"} rel="noopener">{exp.title}</a>
          </h3>
          <p class="card-host">{exp.host}</p>
          <p class="card-summary">{exp.description}</p>
          <p class="card-link">
            <a href={exp.url} target={exp.url.startsWith("https://capabilitymatters.org") || exp.url.startsWith("/") ? undefined : "_blank"} rel="noopener">Open project</a>
          </p>
          {exp.jobAid && (
            <p class="card-link">
              <a href={exp.jobAid.url} download>{exp.jobAid.label}</a>
            </p>
          )}
        </article>
      ))}
    </div>
    </section>
    ))}
  </div>
  <a class="featured-banner" href={featuredPaper.url}>
    <div class="container featured-inner">
      <span class="featured-eyebrow">Supporting reading · Working draft</span>
      <span class="featured-title">{featuredPaper.title}</span>
      <span class="featured-desc">{featuredPaper.description}</span>
      <span class="featured-cta">Read the paper</span>
    </div>
  </a>

</Base>

<style>
  /* Supporting reading remains visually distinct from runnable projects. */
  .directory-intro { padding-bottom: 0; }
  .directory-intro p { max-width: 52rem; }
  .directory-intro nav { display: flex; flex-wrap: wrap; gap: .6rem 1.3rem; font-family: var(--sans); }
  .section-grid section { scroll-margin-top: 8rem; }
  .featured-banner {
    display: block;
    border: none;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(40rem 12rem at 8% 120%, var(--tint-warm) 0%, transparent 70%),
      var(--tint);
  }
  .featured-inner {
    display: grid;
    grid-template-columns: auto;
    gap: .35rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
  }
  .featured-banner:hover { background: var(--tint-warm); }
  .featured-eyebrow {
    font-family: var(--sans);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .featured-title {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
  }
  .featured-desc {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--ink-soft);
    line-height: 1.5;
    max-width: var(--measure);
  }
  .featured-cta {
    font-family: var(--sans);
    font-size: .82rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: .1rem;
  }
  .featured-banner:hover .featured-cta { text-decoration: underline; }

  .section-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }

  /* Card styling mirrors the collection section pages so experiment cards read
     as part of the same system. */
  .card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    transition: border-color .15s ease;
  }
  .card:hover { border-color: var(--accent); }

  .card-meta { display: flex; gap: .35rem; flex-wrap: wrap; align-items: center; }
  .format-chip {
    font-family: var(--sans);
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .15rem .45rem;
    border-radius: 2px;
    color: var(--accent);
    background: var(--tint-warm);
  }

  .card-title {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }
  .card-title a { color: var(--ink); border-bottom: 1px solid transparent; }
  .card-title a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  .card-host {
    font-family: var(--sans);
    font-size: .75rem;
    color: var(--muted);
    margin: 0;
    word-break: break-word;
  }

  .card-summary {
    font-family: var(--serif);
    font-size: .95rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }

  .card-link { margin: .15rem 0 0; }
  .card-link a {
    font-family: var(--sans);
    font-size: .82rem;
    font-weight: 600;
    color: var(--accent);
  }
  .card-link a:hover { text-decoration: underline; }

  @media (max-width: 520px) {
    .card { padding: .95rem 1rem; }
  }
</style>
