---
// Present the canonical Capability Matters manuscript as a journal-style reading edition.
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import Base from "../layouts/Base.astro";
import { compiledContent, getHeadings } from "../papers/show-your-work.md";
import ResourceReading from "../components/ResourceReading.astro";
import "../styles/community-paper.css";

const title = "Capability Matters: Learning Engineering in the context of Next-Generation Systems";
// Scrollable tables remain keyboard reachable when the reading column narrows.
const canonicalHtml = (await compiledContent()).replace(/<table>/g, '<table tabindex="0">');
// Keep the two-part manuscript title together before inserting its About disclosure.
const paperHtml = canonicalHtml.replace(/<h1([^>]*)>Capability Matters<\/h1>\s*<h2[^>]*>(Learning Engineering in the context of Next-Generation Systems)<\/h2>/,
  '<h1$1><span class="paper-name">Capability Matters: </span><span class="paper-subtitle">$2</span></h1>');
const boundary = paperHtml.indexOf('<h2 id="abstract">');
if (boundary < 0 || !paperHtml.includes('class="paper-name"')) throw new Error("Paper title or abstract boundary missing");
const pdfVersion = createHash("sha256").update(readFileSync("public/papers/show-your-work.pdf")).digest("hex").slice(0, 12);
const sections = getHeadings().filter((heading) => heading.depth === 2).slice(1);
---

<Base title={title + " · Community paper"} active="show-your-work" visualTheme="workshop"
  description="A community working paper on learning engineering, capability, coupled learner and system performance, and human flourishing.">
  <header class="paper-cover">
    <div class="paper-cover-inner">
      <p class="paper-edition">Community working paper <span aria-hidden="true">/</span> Open for discussion</p>
      <ResourceReading resource="show-your-work" html={paperHtml.slice(0, boundary)} />
      <nav class="paper-actions" aria-label="Paper downloads">
        <a class="download" href={`/papers/show-your-work.pdf?v=${pdfVersion}`} download>Download the paper <span aria-hidden="true">↗</span><span class="download-format">PDF</span></a>
        <a href="#abstract">Read online ↓</a>
      </nav>
    </div>
  </header>
  <div class="paper-shell reading-layout">
    <aside class="paper-contents">
      <details id="paper-contents">
        <summary>In this paper</summary>
        <nav aria-label="Paper sections">
          {sections.map((section) => <a href={`#${section.slug}`}>{section.text}</a>)}
        </nav>
      </details>
    </aside>
    <article class="paper" aria-label="Working paper text" set:html={paperHtml.slice(boundary)} />
  </div>
</Base>

<script>
  // Start with compact contents on mobile; native disclosure remains usable without JavaScript.
  const contents = document.querySelector<HTMLDetailsElement>("#paper-contents");
  const wide = matchMedia("(min-width: 960px)");
  const setContents = (): void => { if (contents) contents.open = wide.matches; };
  setContents();
  wide.addEventListener("change", setContents);
</script>
