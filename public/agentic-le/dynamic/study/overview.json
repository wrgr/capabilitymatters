{
  "schema_version": "dynamic-flower-overview-1",
  "updated_at": "2026-11-03T20:20:31.023689+00:00",
  "methods": {
    "design": "Four independent case-by-condition conversations; two cases, two conditions, one conversation per cell.",
    "response_origin": "Actual fresh collaboration-agent output submitted through manual transport.",
    "model": "Session-inherited; not independently reported.",
    "boundaries": "Role instructions and validated declared permissions do not erase latent knowledge or independently verify tool/context isolation.",
    "continuations": "Three post-freeze v1 context amendments and one selective workshop design-stage v2 amendment; effective runner allowance 180000 to 600000 characters, with original histories and source pins retained.",
    "evaluation": "One process review and three scenario-result reviews per frozen version, each requested from a fresh evaluator context. No aggregate score or ranking.",
    "limits": "Illustrative pilot; no statistical condition effect, measured human learning, or human usability claim. Repeated scenarios and updated versions are not independent teams."
  },
  "rubric": {
    "process": [
      {
        "id": "agency_and_burden",
        "label": "Human concerns influence decisions",
        "axis": "human_flourishing",
        "description": "Check whether learner agency, access and burden concerns are raised, addressed and retained in decisions."
      },
      {
        "id": "domain_boundaries",
        "label": "Expertise boundaries and uncertainty",
        "axis": "system_performance",
        "description": "Check authorized domain claims, appropriate requests, uncertainty and honest gaps; missing expertise alone is not an automatic failure."
      },
      {
        "id": "responsive_dialogue",
        "label": "Questions and objections receive substantive responses",
        "axis": "learning",
        "description": "Trace whether later contributions answer earlier questions, revise assumptions and resolve or retain disagreement."
      },
      {
        "id": "decision_traceability",
        "label": "Decisions and implementation are traceable",
        "axis": "system_performance",
        "description": "Link requirements, tradeoffs and approvals to actual artifact changes; do not reward a summary that claims unperformed work."
      },
      {
        "id": "learning_reasoning",
        "label": "Learning mechanisms and evidence are reasoned about",
        "axis": "learning",
        "description": "Check the connection among target capability, practice, feedback and proposed evidence, including limits of inference."
      },
      {
        "id": "participation",
        "label": "Relevant perspectives and user updates are considered",
        "axis": "human_flourishing",
        "description": "Check whose concerns shape the solution and whether user changes are acknowledged with consequences and limitations."
      }
    ],
    "result": [
      {
        "id": "agency_access",
        "label": "Agency, access and manageable burden",
        "axis": "human_flourishing",
        "description": "Use observed skip, correction, keyboard, viewport and directions evidence; distinguish observed behavior from untested user experience."
      },
      {
        "id": "task_behavior",
        "label": "Behavior under the supplied scenario",
        "axis": "system_performance",
        "description": "Inspect actual inputs, outputs and errors against the scenario facts and constraints; credit a valid simple solution."
      },
      {
        "id": "recovery",
        "label": "Recovery and update behavior",
        "axis": "system_performance",
        "description": "Check whether changed facts, revision, clearing, interruptions and resource constraints produce usable recoverable behavior."
      },
      {
        "id": "capability_support",
        "label": "Support for the intended capability",
        "axis": "learning",
        "description": "Judge alignment of the actual task, activity and output to the capability; do not claim human attainment."
      },
      {
        "id": "feedback_and_revision",
        "label": "Feedback and revision quality",
        "axis": "learning",
        "description": "Inspect initial and revised responses and resulting feedback for useful explanation and honest limits, not just textual change."
      },
      {
        "id": "credible_use",
        "label": "Feasible and respectful use in context",
        "axis": "human_flourishing",
        "description": "Assess whether the solution can responsibly be used in the supplied situation, with appropriate limits and alternatives."
      }
    ],
    "score_min": 0,
    "score_max": 4,
    "anchors": {
      "0": "Observed evidence contradicts the criterion or the relevant mechanism is absent.",
      "1": "A partial or fragile response with material observed gaps.",
      "2": "Adequate evidence for a limited portion of the criterion, with clear limitations.",
      "3": "Strong, coherent evidence across the relevant recorded conditions.",
      "4": "Consistent, well-supported evidence with appropriate handling of exceptions and uncertainty.",
      "unknown": "Evidence is missing, unexecuted, invalid or insufficient to support a rating."
    },
    "aggregation": "Report process once per artifact version and result separately per difficulty. Show criterion scores and evidence; do not combine process, result or axes into a ranking."
  },
