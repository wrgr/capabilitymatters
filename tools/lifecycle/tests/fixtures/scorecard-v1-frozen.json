        "burden_wellbeing": {
          "axis": "human_flourishing",
          "label": "Burden and wellbeing",
          "description": "Inspect effort, demands, support, and foreseeable burdens relative to the task's purpose and constraints."
        },
        "functional_correctness": {
          "axis": "system_performance",
          "label": "Functional correctness",
          "description": "Inspect whether the actual artifact implements required input-output behavior; distinguish executed checks from source inspection."
        },
        "reliability_recovery": {
          "axis": "system_performance",
          "label": "Reliability and recovery",
          "description": "Inspect correction, clearing, failure recovery, and behavior under the task's stated operating conditions."
        },
        "feasibility": {
          "axis": "system_performance",
          "label": "Feasibility",
          "description": "Inspect implementation and delivery requirements against available time, resources, and support; declarations alone do not verify them."
        },
        "alignment": {
