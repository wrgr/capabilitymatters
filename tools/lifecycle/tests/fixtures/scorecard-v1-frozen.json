          "label": "Capability alignment",
          "description": "Inspect whether the activity exercises the intended capability and makes success criteria relevant to the stated task."
        },
        "practice_feedback": {
          "axis": "learning",
          "label": "Practice feedback and revision",
          "description": "Inspect consequential practice choices, feedback contingent on those choices, and opportunities to revise; do not reward mere terminology."
        },
        "transfer_evidence": {
          "axis": "learning",
          "label": "Learning evidence design",
          "description": "Inspect what could establish independent capability or use on a changed task, and whether claims respect absent evidence; supported completion is not measured learning."
        }
